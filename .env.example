# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Survey links are derived from this secret. At least 32 random characters.
# Changing it breaks every link already sent. Generate with: openssl rand -base64 48
SURVEY_TOKEN_SECRET=

# Public URL used in survey links
APP_URL=http://localhost:3000

# Email (Resend). Leave blank in development: messages are logged instead.
RESEND_API_KEY=
EMAIL_FROM="CuraCulture <surveys@yourdomain.com>"

# Text messages (Twilio). Leave blank in development: messages are logged instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
