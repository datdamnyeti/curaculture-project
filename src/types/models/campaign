// src/types/models/campaign.ts
export type SurveyType = 'culture' | 'retention' | 'satisfaction';

export interface SurveyCampaign {
  id: string;
  clinicId: string;
  name: string;
  description?: string;
  createdAt: Date;
  expiresAt?: Date;
  status: 'draft' | 'active' | 'completed' | 'expired';
  surveyType: SurveyType;
  emailSubject: string;
  emailBody: string;
}

export interface CampaignData {
  name: string;
  description: string;
  surveyType: SurveyType;
  emailSubject: string;
  emailBody: string;
}

export interface SurveyInvitation {
  id: string;
  campaignId: string;
  email: string;
  token: string;
  sentAt?: Date;
  completedAt?: Date;
  status: 'pending' | 'sent' | 'clicked' | 'completed' | 'bounced';
  remindersSent: number;
}

export interface CampaignStatistics {
  sent: number;
  completed: number;
  pending: number;
  clicked: number;
  responseRate: number;
}

export interface CampaignSummary {
  id: string;
  name: string;
  description?: string;
  status: 'draft' | 'active' | 'completed' | 'expired';
  responseCount: number;
  responseRate: number;
  createdAt: Date;
  surveyType: SurveyType;
}